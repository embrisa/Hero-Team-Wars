{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/transaction-manifest.schema.json",
  "title": "WC3 map transaction manifest",
  "type": "object",
  "required": ["schema_version", "transaction_id", "project_id", "state", "revision", "source", "staged_copy_sha256", "canonical_sha256", "revision_hashes", "created_utc", "updated_utc", "versions", "operation_ids", "operation_revisions", "operation_records", "validation_reports", "build_ids", "test_session_ids"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "transaction_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string" },
    "label": { "type": "string", "maxLength": 100 },
    "state": { "type": "string", "enum": ["created", "staged", "modified", "validated", "built", "tested", "promoted", "discarded", "failed"] },
    "revision": { "type": "integer", "minimum": 0 },
    "source": { "type": "object", "required": ["path", "size_bytes", "modified_utc", "sha256"], "properties": { "path": { "type": "string" }, "size_bytes": { "type": "integer", "minimum": 0 }, "modified_utc": { "type": "string", "format": "date-time" }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } }, "additionalProperties": true },
    "staged_copy_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "canonical_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "revision_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9A-F]{64}$" } },
    "created_utc": { "type": "string", "format": "date-time" },
    "updated_utc": { "type": "string", "format": "date-time" },
    "versions": { "type": "object", "required": ["server", "engine", "schema", "worker_protocol", "dependencies"], "properties": { "server": { "type": "string" }, "engine": { "type": "string" }, "schema": { "type": "string" }, "worker_protocol": { "type": "string" }, "dependencies": { "type": "object", "additionalProperties": { "type": "string" } } }, "additionalProperties": false },
    "operation_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "operation_revisions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "operation_records": { "type": "array", "items": { "type": "object", "required": ["transaction_id", "operation_id", "revision", "type", "target", "rationale", "source_sha256", "semantic_diff_artifact", "validation_report_artifacts", "build_artifacts", "test_session_ids"], "properties": { "transaction_id": { "type": "string", "format": "uuid" }, "operation_id": { "type": "string", "format": "uuid" }, "revision": { "type": "integer", "minimum": 1 }, "type": { "type": "string" }, "target": { "type": "object" }, "expected": {}, "value": {}, "rationale": { "type": "string" }, "design_reference": { "type": "string", "pattern": "^HTW-[0-9]{2}$" }, "source_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }, "semantic_diff_artifact": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } }, "additionalProperties": false }, "validation_report_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "build_artifacts": { "type": "array", "items": { "type": "object", "required": ["build_id", "output_sha256", "manifest_path", "manifest_sha256"], "properties": { "build_id": { "type": "string", "format": "uuid" }, "output_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }, "manifest_path": { "type": "string" }, "manifest_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } }, "additionalProperties": false } }, "test_session_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } } }, "additionalProperties": false } },
    "validation_reports": { "type": "array", "items": { "type": "string" } },
    "build_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "test_session_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "failure": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": { "artifact": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" } }, "additionalProperties": false } }
}
