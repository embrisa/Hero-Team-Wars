{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/change-operation.schema.json",
  "title": "WC3 typed map change operation",
  "type": "object",
  "required": ["operation_id", "type", "target", "rationale"],
  "properties": {
    "operation_id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "enum": ["set_map_metadata", "create_player_slot", "set_player_slot", "delete_player_slot", "create_force", "set_force", "delete_force", "create_team", "set_team", "delete_team", "set_team_arena", "set_team_members", "update_region", "create_region", "rename_region", "delete_region", "reorder_regions", "set_region_role", "create_object_definition", "update_object_definition", "delete_object_definition", "set_object_reference", "place_object", "move_object", "update_placed_object", "remove_placed_object", "place_unit", "move_unit", "remove_placed_unit", "set_object_data", "set_script_source", "upsert_script_module", "remove_script_module", "set_trigger_mode", "create_trigger", "update_trigger", "move_trigger", "delete_trigger", "create_variable", "update_variable", "delete_variable"] },
    "target": { "type": "object", "additionalProperties": true },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "expected": {},
    "value": {},
    "rationale": { "type": "string", "minLength": 1 },
    "design_reference": { "type": "string", "pattern": "^HTW-[0-9]{2}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "player_target": { "type": "object", "required": ["id"], "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 24 } }, "additionalProperties": false },
    "player_record": {
      "type": "object", "required": ["name", "controller", "race", "flags", "start", "ally_low_priority_mask", "ally_high_priority_mask", "enemy_low_priority_mask", "enemy_high_priority_mask"],
      "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 24 }, "name": { "type": "string", "minLength": 1 }, "controller": { "enum": ["None", "User", "Computer", "Neutral", "Rescuable"] }, "race": { "enum": ["Human", "Orc", "NightElf", "Undead", "Random", "Selectable"] }, "flags": { "type": "integer", "minimum": 0 }, "start": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false }, "ally_low_priority_mask": { "type": "integer", "minimum": 0 }, "ally_high_priority_mask": { "type": "integer", "minimum": 0 }, "enemy_low_priority_mask": { "type": "integer", "minimum": 0 }, "enemy_high_priority_mask": { "type": "integer", "minimum": 0 }, "observer": { "type": ["boolean", "null"] }, "locked": { "type": "boolean" } },
      "additionalProperties": false
    },
    "player_update": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1 }, "controller": { "enum": ["None", "User", "Computer", "Neutral", "Rescuable"] }, "race": { "enum": ["Human", "Orc", "NightElf", "Undead", "Random", "Selectable"] }, "flags": { "type": "integer", "minimum": 0 }, "start": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false }, "ally_low_priority_mask": { "type": "integer", "minimum": 0 }, "ally_high_priority_mask": { "type": "integer", "minimum": 0 }, "enemy_low_priority_mask": { "type": "integer", "minimum": 0 }, "enemy_high_priority_mask": { "type": "integer", "minimum": 0 }, "observer": { "type": ["boolean", "null"] }, "locked": { "type": "boolean" } }, "additionalProperties": false },
    "force_target": { "type": "object", "required": ["index"], "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 23 } }, "additionalProperties": false },
    "force_record": {
      "type": "object", "required": ["name", "flags", "player_ids", "player_mask"],
      "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 23 }, "name": { "type": "string", "minLength": 1 }, "flags": { "type": "integer", "minimum": 0 }, "player_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 24 }, "uniqueItems": true }, "player_mask": { "type": "integer" }, "alliance": { "type": "boolean" }, "shared_vision": { "type": "boolean" }, "shared_unit_control": { "type": "boolean" } },
      "additionalProperties": false
    },
    "force_update": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1 }, "flags": { "type": "integer", "minimum": 0 }, "player_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 24 }, "uniqueItems": true }, "player_mask": { "type": "integer" }, "alliance": { "type": "boolean" }, "shared_vision": { "type": "boolean" }, "shared_unit_control": { "type": "boolean" } }, "additionalProperties": false },
    "team_target": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^team_[0-9]+$" } }, "additionalProperties": false },
    "team_record": {
      "type": "object", "required": ["name", "member_player_ids", "force_index", "arena_id", "hero_ids", "life_state", "routing_state"],
      "properties": { "id": { "type": "string", "pattern": "^team_[0-9]+$" }, "name": { "type": "string", "minLength": 1 }, "member_player_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 24 }, "uniqueItems": true }, "force_index": { "type": "integer", "minimum": 0, "maximum": 23 }, "arena_id": { "type": "string", "minLength": 1 }, "hero_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "life_state": { "type": "string", "minLength": 1 }, "routing_state": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "team_update": { "type": "object", "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1 }, "member_player_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 24 }, "uniqueItems": true }, "force_index": { "type": "integer", "minimum": 0, "maximum": 23 }, "arena_id": { "type": "string", "minLength": 1 }, "hero_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "life_state": { "type": "string", "minLength": 1 }, "routing_state": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "module": {
      "type": "object",
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1, "maxLength": 2097152 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "enabled": { "type": "boolean" },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" }, "uniqueItems": true },
        "public_symbols": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "uniqueItems": true },
        "provenance": { "type": "string" }, "capability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["map_initialization", "periodic_timer", "elapsed_time", "player_chat", "unit_death", "region_entry", "player_state_change", "custom_event"] }, "period": { "type": "number", "exclusiveMinimum": 0 }, "seconds": { "type": "number", "minimum": 0 }, "player_id": { "type": "integer", "minimum": 1, "maximum": 24 }, "message": { "type": "string", "minLength": 1 }, "exact": { "type": "boolean" }, "region_id": { "type": "string" }, "region_name": { "type": "string" }, "unit_rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "state": { "type": "string" }, "operator": { "type": "string" }, "value": { "type": "number" }, "name": { "type": "string" } },
      "additionalProperties": false
    },
    "condition": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["always", "boolean_variable", "integer_compare", "real_compare", "function"] }, "variable_id": { "type": "string" }, "operator": { "type": "string" }, "value": {}, "function": { "type": "string" } }, "additionalProperties": false },
    "action": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["set_variable", "branch", "create_timer", "unit_operation", "group_operation", "message", "phase_transition", "call_function", "return"] }, "variable_id": { "type": "string" }, "value": {}, "condition": { "$ref": "#/$defs/condition" }, "then": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "else": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "period": { "type": "number", "exclusiveMinimum": 0 }, "repeating": { "type": "boolean" }, "callback": { "type": "string" }, "operation": { "type": "string" }, "group_variable_id": { "type": "string" }, "text": { "type": "string" }, "phase": { "type": "integer" }, "function": { "type": "string" } }, "additionalProperties": false },
    "trigger": {
      "type": "object",
      "required": ["id", "name", "folder_path", "events"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "name": { "type": "string", "minLength": 1 }, "folder_path": { "type": "string", "minLength": 1 }, "enabled": { "type": "boolean" }, "initially_on": { "type": "boolean" },
        "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }, "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }, "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "references": { "type": "object" }, "source_location": { "type": "object" }, "handler_name": { "type": "string" }, "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "editor_encoding": { "type": "object" }, "provenance": { "type": "string" }, "capability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "type": { "enum": ["integer", "real", "boolean", "string", "handle", "timer", "trigger", "unit", "group", "region", "rect", "player", "force"] }, "initial": {}, "default_value": {}, "value": {}, "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "provenance": { "type": "string" }, "capability": { "type": "string" } },
      "additionalProperties": false
    },
    "region_target": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string", "pattern": "^region:[0-9]+$" },
        "region_id": { "type": "string", "pattern": "^region:[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "creation_number": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "region_record": {
      "type": "object",
      "required": ["id", "name", "min_x", "min_y", "max_x", "max_y", "creation_number", "weather", "ambient_sound", "color_argb", "references", "codec_version", "provenance", "capability"],
      "properties": {
        "id": { "type": "string", "pattern": "^region:[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "stored_name": { "type": "string", "minLength": 1 },
        "min_x": { "type": "number" }, "min_y": { "type": "number" }, "max_x": { "type": "number" }, "max_y": { "type": "number" },
        "creation_number": { "type": "integer", "minimum": 0 }, "weather": { "type": "string" }, "ambient_sound": { "type": "string" }, "color_argb": { "type": "integer" },
        "references": { "$ref": "#/$defs/region_references" }, "codec_version": { "const": "war3net-6.0.3-mapregions-v5" },
        "provenance": { "type": "string" }, "capability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "region_references": {
      "type": "object",
      "required": ["mcp_owned", "editor_trigger", "custom_text", "derived_roles"],
      "properties": { "mcp_owned": { "type": "array" }, "editor_trigger": { "type": "array" }, "custom_text": { "type": "array" }, "derived_roles": { "type": "array" } },
      "additionalProperties": false
    },
    "region_create": {
      "type": "object",
      "required": ["name", "min_x", "min_y", "max_x", "max_y"],
      "properties": {
        "id": { "type": "string", "pattern": "^region:[0-9]+$" }, "name": { "type": "string", "minLength": 1 },
        "min_x": { "type": "number" }, "min_y": { "type": "number" }, "max_x": { "type": "number" }, "max_y": { "type": "number" },
        "creation_number": { "type": "integer", "minimum": 0 }, "weather": { "type": "string" }, "ambient_sound": { "type": "string" }, "color_argb": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "region_update": {
      "type": "object",
      "minProperties": 1,
      "properties": { "min_x": { "type": "number" }, "min_y": { "type": "number" }, "max_x": { "type": "number" }, "max_y": { "type": "number" }, "weather": { "type": "string" }, "ambient_sound": { "type": "string" }, "color_argb": { "type": "integer" } },
      "additionalProperties": false
    },
    "reference_rewrite_plan": {
      "type": "object",
      "required": ["mcp_owned", "editor_trigger", "custom_text"],
      "properties": {
        "mcp_owned": { "oneOf": [{ "enum": ["rewrite", "unchanged", "not_applicable"] }, { "type": "array" }] },
        "editor_trigger": { "oneOf": [{ "enum": ["rewrite", "unchanged", "not_applicable"] }, { "type": "array" }] },
        "custom_text": { "oneOf": [{ "enum": ["rewrite", "unchanged", "not_applicable"] }, { "type": "array" }] },
        "unresolved": { "type": "array" }
      },
      "additionalProperties": false
    },
    "object_target": {
      "type": "object",
      "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "enum": ["unit", "ability", "item", "destructable", "doodad", "buff", "upgrade"] }, "rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" } },
      "additionalProperties": false
    },
    "object_modification": {
      "type": "object",
      "required": ["id", "type", "value"],
      "properties": { "id": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "type": { "enum": ["Int", "Real", "Unreal", "String", "Bool", "Char"] }, "value": {}, "level": { "type": "integer", "minimum": 0 }, "pointer": { "type": "integer", "minimum": 0 }, "variation": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "object_definition": {
      "type": "object",
      "required": ["category", "object_kind", "base_rawcode", "custom_rawcode", "rawcode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "archive_path": { "type": "string", "minLength": 1 }, "category": { "enum": ["unit", "ability", "item", "destructable", "doodad", "buff", "upgrade"] }, "object_kind": { "enum": ["base", "custom"] },
        "base_rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "custom_rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "display_name": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" } }, "references": { "type": "object" }, "unknown_ids": { "type": "array", "items": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" } }, "modifications": { "type": "array", "items": { "$ref": "#/$defs/object_modification" } }, "codec_version": { "type": "string" }, "provenance": { "type": "string" }, "capability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object", "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } },
      "additionalProperties": false
    },
    "placement_target": {
      "type": "object", "minProperties": 1,
      "properties": { "id": { "type": "string", "pattern": "^(unit|doodad):[0-9]+$" }, "creation_number": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "placement": {
      "type": "object", "required": ["kind", "rawcode", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^(unit|doodad):[0-9]+$" }, "member": { "enum": ["war3mapUnits.doo", "war3map.doo"] }, "kind": { "enum": ["unit", "building", "item", "doodad", "destructable", "special_doodad"] }, "rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "skin_rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "owner_id": { "type": "integer", "minimum": 1, "maximum": 24 }, "flags": { "type": "integer" },
        "inventory": { "type": "array" }, "abilities": { "type": "array" }, "position": { "$ref": "#/$defs/position" }, "facing": { "type": "number" }, "scale": { "$ref": "#/$defs/position" }, "variation": { "type": "integer", "minimum": 0 }, "creation_number": { "type": "integer", "minimum": 0 }, "waygate_destination_region_id": { "type": "integer", "minimum": -1 }, "map_region_role": {}, "provenance": { "type": "string" }, "capability": { "type": "string" }
      },
      "additionalProperties": false
    },
    "placement_update": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "skin_rawcode": { "type": "string", "pattern": "^[\\x20-\\x7E]{4}$" }, "owner_id": { "type": "integer", "minimum": 1, "maximum": 24 }, "flags": { "type": "integer" }, "hit_points": { "type": "integer" }, "mana_points": { "type": "integer" }, "hero_level": { "type": "integer", "minimum": 0 }, "hero_strength": { "type": "integer", "minimum": 0 }, "hero_agility": { "type": "integer", "minimum": 0 }, "hero_intelligence": { "type": "integer", "minimum": 0 }, "inventory": { "type": "array" }, "abilities": { "type": "array" }, "variation": { "type": "integer", "minimum": 0 }, "position": { "$ref": "#/$defs/position" }, "facing": { "type": "number" }, "scale": { "$ref": "#/$defs/position" }, "map_region_role": {}, "waygate_destination_region_id": { "type": "integer", "minimum": -1 }, "custom_player_color_id": { "type": "integer" }, "life": { "type": "integer", "minimum": 0, "maximum": 255 }, "state": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "required": ["type"], "properties": { "type": { "const": "create_player_slot" } } }, "then": { "required": ["value"], "properties": { "target": { "$ref": "#/$defs/player_target" }, "value": { "$ref": "#/$defs/player_record" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "set_player_slot" } } }, "then": { "required": ["expected", "value"], "properties": { "target": { "$ref": "#/$defs/player_target" }, "value": { "$ref": "#/$defs/player_update" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "delete_player_slot" } } }, "then": { "required": ["expected"], "properties": { "target": { "$ref": "#/$defs/player_target" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "create_force" } } }, "then": { "required": ["value"], "properties": { "target": { "$ref": "#/$defs/force_target" }, "value": { "$ref": "#/$defs/force_record" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "set_force" } } }, "then": { "required": ["expected", "value"], "properties": { "target": { "$ref": "#/$defs/force_target" }, "value": { "$ref": "#/$defs/force_update" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "delete_force" } } }, "then": { "required": ["expected"], "properties": { "target": { "$ref": "#/$defs/force_target" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "create_team" } } }, "then": { "required": ["value"], "properties": { "target": { "$ref": "#/$defs/team_target" }, "value": { "$ref": "#/$defs/team_record" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "enum": ["set_team", "delete_team", "set_team_arena", "set_team_members"] } } }, "then": { "required": ["expected"], "properties": { "target": { "$ref": "#/$defs/team_target" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "set_team" } } }, "then": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/team_update" } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "set_team_arena" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "object", "required": ["arena_id"], "properties": { "arena_id": { "type": "string", "minLength": 1 } }, "additionalProperties": false } } } },
    { "if": { "required": ["type"], "properties": { "type": { "const": "set_team_members" } } }, "then": { "required": ["value"], "properties": { "value": { "type": "object", "required": ["member_player_ids"], "properties": { "member_player_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 24 }, "uniqueItems": true } }, "additionalProperties": false } } } },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "set_script_source" } } },
      "then": {
        "required": ["expected", "value"],
        "properties": {
          "target": {
            "type": "object",
            "required": ["archive_path"],
            "properties": { "archive_path": { "const": "war3map.j" } },
            "additionalProperties": false
          },
          "expected": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }, "additionalProperties": false }
            ]
          },
          "value": {
            "type": "object",
            "required": ["language", "source"],
            "properties": { "language": { "type": "string", "pattern": "^[jJ][aA][sS][sS]$" }, "source": { "type": "string", "minLength": 1, "maxLength": 16777216 } },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "upsert_script_module" } } },
      "then": { "required": ["value"], "properties": { "target": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" } }, "additionalProperties": false }, "value": { "$ref": "#/$defs/module" }, "expected": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "object", "required": ["source_sha256"], "properties": { "source_sha256": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false }, { "type": "object" }] } } }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "remove_script_module" } } },
