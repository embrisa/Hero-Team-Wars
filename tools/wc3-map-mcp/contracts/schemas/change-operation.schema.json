{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/change-operation.schema.json",
  "title": "WC3 typed map change operation",
  "type": "object",
  "required": ["operation_id", "type", "target", "rationale"],
  "properties": {
    "operation_id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "enum": ["set_map_metadata", "create_player_slot", "set_player_slot", "delete_player_slot", "create_force", "set_force", "delete_force", "create_team", "set_team", "delete_team", "set_team_arena", "set_team_members", "update_region", "create_region", "rename_region", "delete_region", "set_region_role", "create_object_definition", "update_object_definition", "delete_object_definition", "set_object_reference", "place_object", "move_object", "update_placed_object", "remove_placed_object", "place_unit", "move_unit", "remove_placed_unit", "set_object_data", "set_script_source", "upsert_script_module", "remove_script_module", "set_trigger_mode", "create_trigger", "update_trigger", "move_trigger", "delete_trigger", "create_variable", "update_variable", "delete_variable"] },
    "target": { "type": "object", "additionalProperties": true },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "expected": {},
    "value": {},
    "rationale": { "type": "string", "minLength": 1 },
    "design_reference": { "type": "string", "pattern": "^HTW-[0-9]{2}$" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "set_script_source" } } },
      "then": {
        "required": ["expected", "value"],
        "properties": {
          "target": {
            "type": "object",
            "required": ["archive_path"],
            "properties": { "archive_path": { "const": "war3map.j" } },
            "additionalProperties": false
          },
          "expected": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }, "additionalProperties": false }
            ]
          },
          "value": {
            "type": "object",
            "required": ["language", "source"],
            "properties": { "language": { "type": "string", "pattern": "^[jJ][aA][sS][sS]$" }, "source": { "type": "string", "minLength": 1, "maxLength": 16777216 } },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
