{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/engine-response.schema.json",
  "title": "WC3 map engine response",
  "type": "object",
  "required": ["protocol_version", "request_id", "ok"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "ok": { "type": "boolean" },
    "result": {},
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } } }, "then": { "required": ["result"], "not": { "required": ["error"] } } },
    { "if": { "properties": { "ok": { "const": false } } }, "then": { "required": ["error"], "not": { "required": ["result"] } } }
  ],
  "additionalProperties": false
}
