{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/build-manifest.schema.json",
  "title": "WC3 map build manifest",
  "description": "Hash-linked, independently re-inspected Phase 3 build identity and preservation evidence.",
  "type": "object",
  "required": [
    "schema_version", "build_id", "project_id", "transaction_id", "revision",
    "profile", "source_sha256", "output_path", "output_sha256", "output_size_bytes",
    "writer_version", "validator_version", "validation_report", "archive_comparison",
    "reinspection", "warnings", "runtime_status", "created_utc", "engine_result"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "build_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "minLength": 1 },
    "transaction_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 0 },
    "profile": { "type": "string", "enum": ["debug", "release", "noop"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "output_path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+\\.(w3m|w3x)$" },
    "output_sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "output_size_bytes": { "type": "integer", "minimum": 0 },
    "writer_version": { "type": "string", "minLength": 1 },
    "validator_version": { "type": "string", "minLength": 1 },
    "validation_report": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      },
      "additionalProperties": false
    },
    "archive_comparison": { "type": "object", "additionalProperties": true },
    "reinspection": {
      "type": "object",
      "required": ["performed", "semantic_differences", "output_hash"],
      "properties": {
        "performed": { "const": true },
        "semantic_differences": { "type": "array" },
        "output_hash": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array" },
    "runtime_status": { "type": "string", "enum": ["untested", "process_started", "editor_opened", "game_loaded", "smoke_passed", "playtest_passed"] },
    "created_utc": { "type": "string", "format": "date-time" },
    "engine_result": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
