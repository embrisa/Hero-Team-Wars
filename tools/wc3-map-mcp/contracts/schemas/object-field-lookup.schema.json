{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "unit",
        "ability",
        "item",
        "buff",
        "upgrade",
        "doodad",
        "destructable"
      ]
    },
    "base_rawcode": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{4}$"
    }
  },
  "required": [
    "field"
  ],
  "additionalProperties": false
}
