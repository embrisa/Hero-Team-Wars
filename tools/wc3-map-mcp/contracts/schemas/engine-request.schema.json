{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.wc3-map-mcp/schemas/engine-request.schema.json",
  "title": "WC3 map engine request",
  "type": "object",
  "required": ["protocol_version", "request_id", "operation", "payload"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "operation": { "type": "string", "enum": ["environment_status", "hash_file", "list_archive_members", "probe_map", "inspect_map", "read_script_source", "validate_map", "validate_canonical", "apply_operations", "build_map", "compare_maps", "compose_gameplay_source", "validate_gameplay_source", "run_scenario", "jass_lookup", "object_field_lookup", "object_field_search", "object_field_annotations", "jass_search", "jass_validate_call", "jass_validate_source"] },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
