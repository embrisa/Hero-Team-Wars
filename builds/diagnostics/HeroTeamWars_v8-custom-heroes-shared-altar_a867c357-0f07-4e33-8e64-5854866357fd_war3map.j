function HTW_Trigger_hero_death takes nothing returns nothing
    if not (true) then
        return
    endif
    call HTW_Heroes_OnDeath()
endfunction

function HTW_Trigger_map_init takes nothing returns nothing
    if not (true) then
        return
    endif
    call HTW_Heroes_Initialize()
    call HTW_HeroSelection_Begin()
endfunction

function HTW_Trigger_round_start takes nothing returns nothing
    if not (true) then
        return
    endif
    call HTW_Information_Display()
endfunction

function HTW_Trigger_runtime_tick takes nothing returns nothing
    if not (true) then
        return
    endif
    call HTW_Phases_Tick()
    call HTW_Sending_ProcessQueues()
