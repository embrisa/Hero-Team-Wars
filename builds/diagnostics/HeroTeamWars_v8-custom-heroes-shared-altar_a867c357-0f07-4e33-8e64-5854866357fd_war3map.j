    loop
        exitwhen teamIndex > HTW_TeamCount
        if HTW_TeamMemberA[teamIndex] == playerId or HTW_TeamMemberB[teamIndex] == playerId then
            return teamIndex
        endif
        set teamIndex = teamIndex + 1
    endloop
    return 0
endfunction

